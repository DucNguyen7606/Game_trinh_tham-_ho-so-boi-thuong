{
  "name": "ho-so-boi-thuong",
  "productName": "Hồ sơ bồi thường",
  "version": "0.1.0",
  "private": true,
  "description": "Game trinh thám suy luận: chuyên viên giám định bảo hiểm ở Sài Gòn.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/bitter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "inkjs": "^2.4.0",
    "lucide-react": "^1.71.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-plugin-electron": "^0.29.1"
  },
  "build": {
    "appId": "vn.hosoboithuong.game",
    "productName": "Ho so boi thuong",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
